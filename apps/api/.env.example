# Run from the repository root with the PMCS PostgreSQL database URL.
DATABASE_URL=postgresql://pmcs:replace-me@localhost:5432/pmcs?schema=pmcs
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
JWT_ISSUER=pmcs-api
JWT_AUDIENCE=pmcs-web
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
COOKIE_SECURE=false

# Copy this file to .env, replace every REPLACE_* value, then restrict its
# permissions (for example: chmod 600 .env). Never commit .env.

# PostgreSQL service and API connection settings. POSTGRES_PASSWORD may contain
# special characters; the API constructs an escaped SQLAlchemy URL from these
# fields. DATABASE_URL is only needed when connecting to an external database.
POSTGRES_DB=mint_aics_pmo
POSTGRES_USER=mint
POSTGRES_PASSWORD=mint
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://user:URL_ENCODED_PASSWORD@host:5432/database

# Required application secrets. Generate JWT_SECRET with a password manager or:
# openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD_MIN_12_CHARS

# Comma-separated browser origins. Do not use * when credentials are enabled.
CORS_ORIGINS=http://localhost:8081

# Compose ports are loopback-only by default. Change this only when a trusted
# reverse proxy or firewall protects the host.
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1

REPORT_DIR=/app/reports

# Optional outbound report email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

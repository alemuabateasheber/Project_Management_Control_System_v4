# Runtime connection. Set schema=pmcs so raw SQL uses the PMCS namespace.
DATABASE_URL="postgresql://pmcs_app:change-me@localhost:5432/pmcs?schema=pmcs"

# Direct, migration-only connection. Do not expose this to the web/API runtime.
DIRECT_URL="postgresql://pmcs_migrator:change-me@localhost:5432/pmcs?schema=pmcs"

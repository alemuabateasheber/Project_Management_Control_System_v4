  createdBy OrganizationMembership @relation("CommitmentCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, projectId, reference], map: "commitments_org_project_reference_key")
  @@index([organizationId, projectId, status], map: "commitments_org_project_status_idx")
  @@map("commitments")
  @@schema("pmcs")
}

model ForecastVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  scenario       String   @default("most_likely") @db.VarChar(32)
  status         String   @default("draft") @db.VarChar(32)
  asOfDate       DateTime @map("as_of_date") @db.Date
  currency       String   @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project   Project                @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  createdBy OrganizationMembership @relation("ForecastVersionCreator", fields: [organizationId, createdById], references: [organizationId, id], onDelete: Restrict)
  lines     ForecastLineItem[]

  @@unique([organizationId, id], map: "forecast_versions_org_id_id_key")
  @@unique([organizationId, projectId, id], map: "forecast_versions_org_project_id_key")
  @@unique([organizationId, projectId, versionNumber], map: "forecast_versions_org_project_number_key")
  @@index([organizationId, projectId, asOfDate(sort: Desc)], map: "forecast_versions_org_project_asof_idx")
  @@map("forecast_versions")
  @@schema("pmcs")
}

model ForecastLineItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  forecastVersionId String   @map("forecast_version_id") @db.Uuid
  periodStart       DateTime @map("period_start") @db.Date
  periodEnd         DateTime @map("period_end") @db.Date
  amount            Decimal  @db.Decimal(19, 4)
  currency          String   @db.Char(3)

  forecastVersion ForecastVersion @relation(fields: [organizationId, projectId, forecastVersionId], references: [organizationId, projectId, id], onDelete: Restrict)

  @@index([organizationId, projectId, forecastVersionId, periodStart], map: "forecast_line_items_org_version_period_idx")
  @@map("forecast_line_items")
  @@schema("pmcs")
}


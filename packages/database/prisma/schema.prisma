model AuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorMemberId  String?  @map("actor_membership_id") @db.Uuid
  action         String   @db.VarChar(160)
  resourceType   String   @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  requestId      String?  @map("request_id") @db.VarChar(128)
  correlationId  String?  @map("correlation_id") @db.VarChar(128)
  beforeValue    Json?    @map("before_value") @db.JsonB
  afterValue     Json?    @map("after_value") @db.JsonB
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(1024)
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser    User?                   @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorMember  OrganizationMembership? @relation("AuditActorMembership", fields: [organizationId, actorMemberId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc)], map: "audit_events_org_occurred_idx")
  @@index([organizationId, resourceType, resourceId, occurredAt(sort: Desc)], map: "audit_events_org_resource_idx")
  @@map("audit_events")
  @@schema("pmcs")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String?   @map("aggregate_id") @db.Uuid
  dedupeKey      String?   @map("dedupe_key") @db.VarChar(256)
  payload        Json      @db.JsonB
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  failedAt       DateTime? @map("failed_at") @db.Timestamptz(6)
  attemptCount   Int       @default(0) @map("attempt_count")
  lastError      String?   @map("last_error")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id], map: "outbox_events_organization_id_id_key")
  @@unique([organizationId, dedupeKey], map: "outbox_events_org_dedupe_key")
  @@index([organizationId, processedAt, occurredAt], map: "outbox_events_org_processing_idx")
  @@map("outbox_events")
  @@schema("pmcs")
}
